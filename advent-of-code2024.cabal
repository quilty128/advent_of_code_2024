cabal-version:       3.0
name:                advent-of-code2024
version:             0.1.0.0
-- synopsis:
-- description:
author:              quilty128
maintainer:          quilty.holly@gmail.com
build-type:          Simple
extra-source-files:  README.md

common common-options
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
      base ^>=4.13 && <5
    , vector
    , matrix

executable day1
  import: common-options
  main-is: Day1/Main.hs
  hs-source-dirs: src

executable day2
  import: common-options
  main-is: Day2/Main.hs
  hs-source-dirs: src

executable day3
  import: common-options
  main-is: Day3/Main.hs
  hs-source-dirs: src

executable day4
  import: common-options
  main-is: Day4/Main.hs
  hs-source-dirs: src
  other-modules:
    Shared.VectorHelper
    , Shared.MatrixHelper
  build-depends:
    matrix

executable day5
  import: common-options
  main-is: Day5/Main.hs
  hs-source-dirs: src
